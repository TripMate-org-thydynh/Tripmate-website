# Web chay o cong 3001 vi backend NestJS da chiem 3000.
# Next.js mac dinh cung dung 3000 nen phai doi, neu khong ca hai
# khong the chay cung luc. Xem script `dev` trong package.json.

# URL trang Google Play của app. Để TRỐNG khi app chưa phát hành —
# nút tải sẽ tự chuyển sang trạng thái "Sắp có trên Google Play".
# Sau khi publish: https://play.google.com/store/apps/details?id=com.tripmate.app
NEXT_PUBLIC_PLAY_STORE_URL=

# URL backend NestJS (production), vd https://api.tripmate.app/api/v1
NEXT_PUBLIC_BACKEND_URL=
